{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vision",
  "version": "0.1.0",
  "identifier": "io.github.jakubkodajek.vision",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "Vision", "width": 1280, "height": 820, "minWidth": 880, "minHeight": 560 }],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Vision contributors",
    "homepage": "https://github.com/jakubkodajek/Vision",
    "copyright": "Copyright © 2026 Vision contributors. MIT License.",
    "license": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "Desktop app that runs your own AI coding CLIs per account profile.",
    "longDescription": "Vision is an open-source desktop app for working with AI coding agents. It drives the official command-line tools you already use, such as Claude Code and Codex, and keeps the sign-ins of each account profile (for example Work and Personal) separate. Nothing is hosted and Vision stores no API keys.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "icons/dmg/background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 150 },
        "applicationFolderPosition": { "x": 480, "y": 150 }
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Vision"
      }
    },
    "linux": {
      "deb": {
        "section": "devel",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
