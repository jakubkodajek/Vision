# Document every environment variable the app reads. Never put real values here.

# Absolute path of Vision's data root (app.db, backups/, profiles/). Default: the OS
# per-user local app data directory (Tauri app_local_data_dir()). Use it for development
# and tests so a real profile directory is never touched.
# VISION_DATA_DIR=/absolute/path/to/vision-dev-data
